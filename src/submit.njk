<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Submit Campground Intelligence - RigFitRV</title>
  <meta name="description" content="Submit real-world RV clearance, toad unhooking logistics, or request new campground guides on RigFitRV.">
  <link rel="canonical" href="https://rigfitrv.com/submit.html">
  <link rel="stylesheet" href="/style.css">

  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TV8S962CRT"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TV8S962CRT');
  </script>

  <style>
    .submit-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-top: 1.5rem;
    }
    .submit-form .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .submit-form label {
      font-weight: 700;
      font-size: 0.95rem;
      color: #0f172a;
    }
    .submit-form input[type="text"],
    .submit-form input[type="email"],
    .submit-form select,
    .submit-form textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 0.75rem 0.9rem;
      font-family: inherit;
      font-size: 1rem;
      color: #1e293b;
      background-color: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
    }
    .submit-form input:focus,
    .submit-form select:focus,
    .submit-form textarea:focus {
      outline: none;
      background-color: #ffffff;
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }
    .submit-form textarea {
      min-height: 140px;
      resize: vertical;
      line-height: 1.5;
    }
    .submit-form .btn {
      align-self: flex-start;
      padding: 0.75rem 1.5rem;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
    }
  </style>
</head>
<body>

  {% include "header.njk" %}

  <div class="container">
    <div class="article-card">

      <h1>Submit RVer Intelligence &amp; New Campgrounds</h1>
      <p>Help fellow RVers travel with confidence! Submit a ground-truth update for an existing guide or request a new campground to be added to RigFitRV.</p>

      <form class="submit-form" action="https://formspree.io/f/mjygepzn" method="POST">
        
        <input type="hidden" name="_next" value="https://rigfitrv.com/thank-you.html">

        <div class="form-group">
          <label for="submission-type">Submission Type</label>
          <select id="submission-type" name="submission-type" required>
            <option value="Update Existing Guide">Update Existing Campground Guide</option>
            <option value="Request New Location">Request / Submit New Campground</option>
          </select>
        </div>

        <div class="form-group">
          <label for="campground-name">Campground Name &amp; State</label>
          <input type="text" id="campground-name" name="campground-name" placeholder="e.g. French Creek State Park, PA" required>
        </div>

        <div class="form-group">
          <label for="rig-details">Your Rig Setup (Optional)</label>
          <input type="text" id="rig-details" name="rig-details" placeholder="e.g. 30ft Class C with Jeep Toad">
        </div>

        <div class="form-group">
          <label for="details">Logistical Notes &amp; Intelligence</label>
          <textarea id="details" name="details" placeholder="Share specific details on tree clearance, low branches, unhooking areas, steep hills, or best sites for big rigs..." required></textarea>
        </div>

        <div class="form-group">
          <label for="email">Your Email (Optional, if you'd like credit or follow-up questions)</label>
          <input type="email" id="email" name="email" placeholder="you@example.com">
        </div>

        <button type="submit" class="btn">Send Submission →</button>

      </form>

    </div>
  </div>

  {% include "footer.njk" %}

</body>
</html>
